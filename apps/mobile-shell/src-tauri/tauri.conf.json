{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jianying Auto Editor",
  "version": "0.1.0",
  "identifier": "com.shichenglei.jianyingautoeditor",
  "build": {
    "beforeDevCommand": "pnpm --dir ../client dev",
    "beforeBuildCommand": "pnpm --dir ../client build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jianying Auto Editor",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "targets": "all"
  }
}
